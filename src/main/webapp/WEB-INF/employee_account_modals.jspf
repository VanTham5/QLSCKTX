<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="emp" uri="jakarta.tags.core" %>
<%@ taglib prefix="empFn" uri="jakarta.tags.functions" %>
<div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="employeeProfileTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 id="employeeProfileTitle" class="modal-title fw-bold"><i class="fa-solid fa-user-pen me-2"></i>Thông tin cá nhân</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <form id="employeeProfileForm" action="${pageContext.request.contextPath}/update-profile" data-validation="profile" method="POST">
                    <input type="hidden" name="profilePage" value="${employeeHistoryView ? 'history' : 'home'}">
                    <emp:if test="${param.profileUpdate == 'success'}">
                        <div class="alert alert-success" role="status">Đã cập nhật thông tin cá nhân.</div>
                    </emp:if>
                    <emp:if test="${param.profileUpdate == 'failed' or empty employeeProfile}">
                        <div class="alert alert-danger" role="alert">${empty employeeProfile ? 'Không tải được thông tin cá nhân.' : 'Không thể cập nhật thông tin. Vui lòng thử lại.'}</div>
                    </emp:if>
                    <fieldset disabled>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên đăng nhập</label>
                            <input type="text" class="form-control bg-light" value="${empFn:escapeXml(sessionScope.acc.tenDangNhap)}" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Họ và Tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="fullName" maxlength="100" value="${empFn:escapeXml(employeeProfile.fullName)}" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" inputmode="numeric" class="form-control" name="sdt" maxlength="10" value="${empFn:escapeXml(employeeProfile.phone)}" placeholder="Nhập SĐT..." required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" class="form-control" name="email" maxlength="100" value="${empFn:escapeXml(employeeProfile.email)}" placeholder="Nhập Email...">
                        </div>
                    </fieldset>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-light border me-2" data-bs-dismiss="modal">Đóng</button>
                        <emp:if test="${not empty employeeProfile}">
                            <button type="button" id="editEmployeeProfile" class="btn btn-primary fw-bold">Chỉnh sửa thông tin</button>
                            <button type="submit" id="saveEmployeeProfile" class="btn btn-primary fw-bold" hidden>Cập nhật thông tin</button>
                        </emp:if>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="changePassModal" tabindex="-1" aria-labelledby="employeePasswordTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 id="employeePasswordTitle" class="modal-title fw-bold"><i class="fa-solid fa-key me-2" aria-hidden="true"></i>Đổi mật khẩu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form action="${pageContext.request.contextPath}/change-password" data-validation="password" method="post">
                <input type="hidden" name="profilePage" value="${employeeHistoryView ? 'history' : 'home'}">
                <div class="modal-body p-4">
                    <emp:choose>
                        <emp:when test="${param.passwordUpdate == 'success'}">
                            <div class="alert alert-success" role="status">Đã đổi mật khẩu.</div>
                        </emp:when>
                        <emp:when test="${param.passwordUpdate == 'invalid'}">
                            <div class="alert alert-danger" role="alert">Nhập mật khẩu hiện tại, mật khẩu mới ít nhất 6 ký tự và xác nhận đúng mật khẩu.</div>
                        </emp:when>
                        <emp:when test="${param.passwordUpdate == 'failed'}">
                            <div class="alert alert-danger" role="alert">Không thể đổi mật khẩu. Kiểm tra mật khẩu hiện tại và thử lại.</div>
                        </emp:when>
                    </emp:choose>
                    <label for="employeeOldPass" class="form-label fw-bold">Mật khẩu hiện tại</label>
                    <input id="employeeOldPass" name="oldPass" type="password" autocomplete="current-password" class="form-control mb-3" required>
                    <label for="employeeNewPass" class="form-label fw-bold">Mật khẩu mới</label>
                    <input id="employeeNewPass" name="newPass" type="password" minlength="6" maxlength="72" autocomplete="new-password" class="form-control mb-3" required>
                    <label for="employeeConfirmPass" class="form-label fw-bold">Nhập lại mật khẩu mới</label>
                    <input id="employeeConfirmPass" name="confirmPass" type="password" autocomplete="new-password" class="form-control" required>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-dark fw-bold">Đổi mật khẩu</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const profile = document.getElementById('profileModal');
        const password = document.getElementById('changePassModal');
        const form = document.getElementById('employeeProfileForm');
        const edit = document.getElementById('editEmployeeProfile');
        const save = document.getElementById('saveEmployeeProfile');
        const fields = form.querySelector('fieldset');
        if (edit) {
            edit.addEventListener('click', function () {
                fields.disabled = false;
                edit.hidden = true;
                save.hidden = false;
                form.elements.fullName.focus();
            });
            form.addEventListener('submit', function (event) {
                if (fields.disabled) event.preventDefault();
            });
            profile.addEventListener('hidden.bs.modal', function () {
                form.reset();
                fields.disabled = true;
                edit.hidden = false;
                save.hidden = true;
            });
        }
        password.addEventListener('hidden.bs.modal', function () {
            password.querySelector('form').reset();
        });
        const params = new URLSearchParams(window.location.search);
        if (params.has('passwordUpdate')) {
            bootstrap.Modal.getOrCreateInstance(password).show();
        } else if (params.has('profileUpdate')) {
            bootstrap.Modal.getOrCreateInstance(profile).show();
        }
    });
</script>
