<%@ page pageEncoding="UTF-8" %>
<c:if test="${lastPage > 1}">
    <div class="incident-pagination">
        <nav class="incident-pagination__nav" aria-label="Phân trang kết quả">
            <c:forEach var="targetPage"
                       items="${[pageNumber - 1, 1, pageNumber - 1, pageNumber, pageNumber + 1, lastPage, pageNumber + 1]}"
                       varStatus="step">
                <c:set var="isArrow" value="${step.first or step.last}"/>
                <c:if test="${isArrow or step.index == 1 or step.index == 5 or (targetPage > 1 and targetPage < lastPage)}">
                    <c:if test="${(step.index == 2 and targetPage > 2) or (step.index == 5 and pageNumber + 1 < lastPage - 1)}">
                        <span class="incident-pagination__gap" aria-hidden="true">…</span>
                    </c:if>
                    <c:set var="pageLabel" value="${step.first ? 'Trang trước' : (step.last ? 'Trang sau' : 'Trang '.concat(targetPage))}"/>
                    <c:choose>
                        <c:when test="${targetPage < 1 or targetPage > lastPage}">
                            <span class="incident-pagination__control" role="link" aria-disabled="true" aria-label="${pageLabel}">
                                <i class="fa-solid ${step.first ? 'fa-chevron-left' : 'fa-chevron-right'}" aria-hidden="true"></i>
                            </span>
                        </c:when>
                        <c:when test="${not isArrow and targetPage == pageNumber}">
                            <span class="incident-pagination__control" aria-current="page" aria-label="${pageLabel}" tabindex="-1">${pageNumber}</span>
                        </c:when>
                        <c:otherwise>
                            <c:url var="pageUrl" value="${adminPaginationPath}">
                                <c:param name="page" value="${targetPage}"/>
                                <c:if test="${not empty keyword}">
                                    <c:param name="q" value="${keyword}"/>
                                </c:if>
                                <c:if test="${not empty currentBuilding}">
                                    <c:param name="building" value="${currentBuilding}"/>
                                </c:if>
                                <c:if test="${not empty currentRole}">
                                    <c:param name="role" value="${currentRole}"/>
                                    <c:param name="team" value="${teamFilter}"/>
                                    <c:param name="status" value="${statusFilter}"/>
                                </c:if>
                                <c:if test="${not empty currentFilter}">
                                    <c:param name="filter" value="${currentFilter}"/>
                                    <c:param name="priority" value="${priorityFilter}"/>
                                </c:if>
                            </c:url>
                            <a class="incident-pagination__control" data-list-link href="<c:out value='${pageUrl}'/>" aria-label="${pageLabel}">
                                <c:choose>
                                    <c:when test="${isArrow}">
                                        <i class="fa-solid ${step.first ? 'fa-chevron-left' : 'fa-chevron-right'}" aria-hidden="true"></i>
                                    </c:when>
                                    <c:otherwise>${targetPage}</c:otherwise>
                                </c:choose>
                            </a>
                        </c:otherwise>
                    </c:choose>
                </c:if>
            </c:forEach>
        </nav>
    </div>
</c:if>
