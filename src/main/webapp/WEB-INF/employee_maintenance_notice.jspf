<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="maintenance" uri="jakarta.tags.core" %>
<div class="modal fade" id="maintenanceNoticeModal" tabindex="-1" aria-labelledby="maintenanceNoticeTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="maintenanceNoticeTitle"><i class="fa-solid fa-bullhorn me-2" aria-hidden="true"></i>Thông báo bảo trì</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <maintenance:if test="${param.maintenanceNotice == 'invalid' or param.maintenanceNotice == 'failed'}">
                    <div class="alert alert-danger" role="alert">Chưa đăng được thông báo. Kiểm tra tiêu đề và nội dung rồi thử lại.</div>
                </maintenance:if>
                <form action="${pageContext.request.contextPath}/create-maintenance-notice" method="post">
                    <input type="hidden" name="noticePage" value="${employeeHistoryView ? 'history' : 'home'}">
                    <div class="mb-3">
                        <label for="maintenanceTitle" class="form-label fw-bold">Tiêu đề</label>
                        <input id="maintenanceTitle" type="text" class="form-control" name="tieuDe" placeholder="VD: Lịch bảo trì hệ thống nước tại tòa A1..." maxlength="190" required>
                    </div>
                    <div class="mb-4">
                        <label for="maintenanceContent" class="form-label fw-bold">Nội dung gửi sinh viên</label>
                        <textarea id="maintenanceContent" class="form-control" name="noiDung" rows="5" placeholder="Nhập thời gian, khu vực bảo trì và lưu ý gửi đến sinh viên..." maxlength="5000" required></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary fw-bold">Đăng thông báo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
