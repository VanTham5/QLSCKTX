<%@ page pageEncoding="UTF-8" %>
<div id="incidentPagination" class="incident-pagination" hidden>
    <span class="visually-hidden" data-page-summary role="status"></span>
    <nav class="incident-pagination__nav" aria-label="Phân trang danh sách sự cố">
        <button class="incident-pagination__control" type="button" data-page-prev aria-label="Trang trước">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <span class="incident-pagination__numbers" data-page-numbers></span>
        <button class="incident-pagination__control" type="button" data-page-next aria-label="Trang sau">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </button>
    </nav>
</div>
