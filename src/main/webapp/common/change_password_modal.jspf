<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="passwordFn" uri="jakarta.tags.functions" %>
<div class="modal fade" id="changePassModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-key me-2"></i>Đổi mật khẩu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <% if ("pass_success".equals(request.getParameter("msg"))) { %>
                <div class="alert alert-success alert-dismissible fade show mb-3" role="status">
                    <i class="fa-solid fa-circle-check me-2"></i> Đổi mật khẩu thành công!
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>
                <% if ("weak_new_pass".equals(request.getParameter("error"))) { %>
                <div class="alert alert-danger" role="alert">Mật khẩu mới phải có ít nhất 6 ký tự.</div>
                <% } %>
                <form action="${pageContext.request.contextPath}/change-password" method="POST">
                    <input type="hidden" name="returnTo" value="${passwordFn:escapeXml(changePasswordReturnTo)}">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu cũ <span class="text-danger">*</span></label>
                        <input type="password" class="form-control ${param.error == 'wrong_old_pass' ? 'is-invalid' : ''}" name="oldPass" required autocomplete="current-password">
                        <div class="invalid-feedback">Mật khẩu cũ không chính xác. Vui lòng nhập lại!</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu mới <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" name="newPass" required minlength="6" autocomplete="new-password">
                    </div>
                    <div class="d-flex justify-content-end mt-4">
                        <button type="button" class="btn btn-light border me-2" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-dark fw-bold">Xác nhận đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const params = new URLSearchParams(window.location.search);
        if (params.has("error") || params.get("msg") === "pass_success") {
            bootstrap.Modal.getOrCreateInstance(document.getElementById("changePassModal")).show();
        }
    });
</script>
