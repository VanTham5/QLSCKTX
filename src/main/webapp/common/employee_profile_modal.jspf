<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-pen me-2"></i>Cập nhật thông tin</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <c:if test="${param.profileUpdate == 'success'}">
                    <div class="alert alert-success" role="status">Đã cập nhật thông tin cá nhân.</div>
                </c:if>
                <c:if test="${param.profileUpdate == 'failed' or empty employeeProfile}">
                    <div class="alert alert-danger" role="alert">Không tải được hồ sơ hoặc cập nhật thất bại. Vui lòng thử lại.</div>
                </c:if>
                <form id="employeeProfileForm" action="${pageContext.request.contextPath}/update-profile" method="POST">
                    <input type="hidden" name="profilePage" value="${fn:escapeXml(employeeProfileReturnTo)}">
                    <fieldset id="employeeProfileFields" disabled>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên đăng nhập</label>
                            <input type="text" class="form-control bg-light" value="${fn:escapeXml(sessionScope.acc.tenDangNhap)}" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="fullName" value="${fn:escapeXml(employeeProfile.fullName)}" required maxlength="100">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" name="sdt" value="${fn:escapeXml(employeeProfile.sdt)}" placeholder="Nhập SĐT..." required maxlength="15">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" class="form-control" name="email" value="${fn:escapeXml(employeeProfile.email)}" placeholder="Nhập Email..." maxlength="100">
                        </div>
                    </fieldset>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-light border me-2" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" id="editEmployeeProfile" class="btn btn-primary fw-bold">Chỉnh sửa thông tin</button>
                        <button type="submit" id="saveEmployeeProfile" class="btn btn-primary fw-bold ms-2" hidden>Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("profileModal");
        const form = document.getElementById("employeeProfileForm");
        const fields = document.getElementById("employeeProfileFields");
        const editButton = document.getElementById("editEmployeeProfile");
        const saveButton = document.getElementById("saveEmployeeProfile");

        editButton.addEventListener("click", function () {
            fields.disabled = false;
            editButton.hidden = true;
            saveButton.hidden = false;
            form.elements.fullName.focus();
        });

        modal.addEventListener("hidden.bs.modal", function () {
            form.reset();
            fields.disabled = true;
            editButton.hidden = false;
            saveButton.hidden = true;
        });

        if (new URLSearchParams(window.location.search).has("profileUpdate")) {
            bootstrap.Modal.getOrCreateInstance(modal).show();
        }
    });
</script>
