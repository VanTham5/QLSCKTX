<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="notice" uri="jakarta.tags.core" %>
<!-- MODAL THÔNG BÁO TỪ BQL -->
<div class="modal fade" id="noticeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-bell me-2"></i>Thông báo từ Ban Quản Lý</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div id="noticeList">
                    <jsp:include page="/WEB-INF/student_notice_batch.jsp"/>
                </div>
                <notice:if test="${empty listTB}">
                    <p class="text-center text-muted mt-3">
                        ${noticesUnavailable ? 'Chưa tải được thông báo. Vui lòng tải lại trang.' : 'Hiện không có thông báo nào từ BQL.'}
                    </p>
                </notice:if>
                <notice:if test="${not empty nextNoticeBefore}">
                    <notice:url var="noticeEndpoint" value="/student-notices"/>
                    <div class="text-center">
                        <button type="button" class="btn btn-outline-primary rounded-pill px-3" id="loadMoreNotices"
                                data-url="<notice:out value='${noticeEndpoint}'/>" aria-controls="noticeList">
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true" hidden></span>
                            Xem thêm thông báo
                        </button>
                    </div>
                    <div id="noticeLoadStatus" class="small text-center mt-2" role="status"></div>
                </notice:if>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
<script src="${pageContext.request.contextPath}/js/student-notices.js" defer></script>
