<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="notice" uri="jakarta.tags.core" %>
<!-- MODAL THÔNG BÁO TỪ BQL -->
<div class="modal fade" id="noticeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-bell me-2"></i>Thông báo từ Ban Quản Lý</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <notice:choose><notice:when test="${not empty listTB}"><notice:forEach var="noticeItem" items="${listTB}">
                <div class="card mb-3 border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold text-primary mb-1"><notice:out value="${noticeItem.tieuDe}"/></h6>
                        <div class="text-muted small mb-2"><i class="fa-regular fa-clock me-1"></i> <notice:out value="${noticeItem.ngayTao}"/></div>
                        <p class="mb-0 text-dark" style="font-size: 0.95rem;"><notice:out value="${noticeItem.noiDung}"/></p>
                    </div>
                </div>
                </notice:forEach></notice:when><notice:otherwise>
                <p class="text-center text-muted mt-3">Hiện không có thông báo nào từ BQL.</p>
                </notice:otherwise></notice:choose>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
