<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="profile" uri="jakarta.tags.core" %>
<%@ taglib prefix="profileFn" uri="jakarta.tags.functions" %>
<!-- MODAL THÔNG TIN CÁ NHÂN (SINH VIÊN) -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-pen me-2"></i>Thông tin cá nhân</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <profile:if test="${param.profileUpdate == 'success'}">
                    <div class="alert alert-success" role="status">Đã cập nhật thông tin cá nhân.</div>
                </profile:if>
                <profile:if test="${param.profileUpdate == 'failed'}">
                    <div class="alert alert-danger" role="alert">Không thể cập nhật thông tin. Vui lòng kiểm tra lại dữ liệu và thử lại.</div>
                </profile:if>
                <profile:if test="${empty studentProfile or empty profileRooms}">
                    <div class="alert alert-warning" role="alert">Không tải được đầy đủ dữ liệu hồ sơ.</div>
                </profile:if>
                <form id="studentProfileForm" action="${pageContext.request.contextPath}/update-profile" method="POST">
                    <input type="hidden" name="profilePage" value="${profileFromHistory ? 'history' : 'home'}">
                    <fieldset disabled>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Tên Đăng Nhập</label>
                                <input type="text" class="form-control bg-light" value="${profileFn:escapeXml(sessionScope.acc.tenDangNhap)}" readonly>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Họ và Tên <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="fullName" value="${profileFn:escapeXml(studentProfile.fullName)}" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Số điện thoại</label>
                                <input type="text" class="form-control" name="sdt" value="${profileFn:escapeXml(studentProfile.sdt)}" placeholder="Nhập SĐT..." required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Email</label>
                                <input type="email" class="form-control" name="email" value="${profileFn:escapeXml(studentProfile.email)}" placeholder="Nhập Email...">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Mã Sinh Viên <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="maSV" value="${profileFn:escapeXml(studentProfile.maSV)}" placeholder="VD: SV202160" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Phòng <span class="text-danger">*</span></label>
                                <select class="form-select" name="phongId" required>
                                    <option value="" ${empty studentProfile.phongId ? 'selected' : ''} disabled>-- Chọn phòng --</option>
                                    <profile:forEach var="room" items="${profileRooms}">
                                        <option value="${room.key}" ${studentProfile.phongId == room.key ? 'selected' : ''}>
                                            <profile:out value="${room.value}"/>
                                        </option>
                                    </profile:forEach>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Khoa</label>
                                <select class="form-select" name="khoa" required>
                                    <option value="" ${empty studentProfile.khoa ? 'selected' : ''} disabled>-- Chọn Khoa --</option>
                                    <option value="CNTT" ${studentProfile.khoa == 'CNTT' ? 'selected' : ''}>Công nghệ thông tin</option>
                                    <option value="CK" ${studentProfile.khoa == 'CK' ? 'selected' : ''}>Cơ khí</option>
                                    <option value="NN" ${studentProfile.khoa == 'NN' ? 'selected' : ''}>Ngoại ngữ</option>
                                    <profile:if test="${not empty studentProfile.khoa and studentProfile.khoa != 'CNTT' and studentProfile.khoa != 'CK' and studentProfile.khoa != 'NN'}">
                                        <option value="${profileFn:escapeXml(studentProfile.khoa)}" selected><profile:out value="${studentProfile.khoa}"/></option>
                                    </profile:if>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Lớp</label>
                                <input type="text" class="form-control" name="lop" value="${profileFn:escapeXml(studentProfile.lop)}" placeholder="VD: KTPM01" required>
                            </div>
                        </div>

                    </fieldset>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-light border me-2" data-bs-dismiss="modal">Đóng</button>
                        <profile:if test="${not empty studentProfile and not empty profileRooms}">
                            <button type="button" id="editStudentProfile" class="btn btn-primary fw-bold">Chỉnh sửa thông tin</button>
                            <button type="submit" id="saveStudentProfile" class="btn btn-primary fw-bold" hidden>Cập nhật thông tin</button>
                        </profile:if>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("profileModal");
        const form = document.getElementById("studentProfileForm");
        const fields = form.querySelector("fieldset");
        const editButton = document.getElementById("editStudentProfile");
        const saveButton = document.getElementById("saveStudentProfile");

        if (editButton) {
            editButton.addEventListener("click", function () {
                fields.disabled = false;
                editButton.hidden = true;
                saveButton.hidden = false;
                form.elements.fullName.focus();
            });

            form.addEventListener("submit", function (event) {
                if (fields.disabled) {
                    event.preventDefault();
                }
            });

            modal.addEventListener("hidden.bs.modal", function () {
                form.reset();
                fields.disabled = true;
                editButton.hidden = false;
                saveButton.hidden = true;
            });
        }

        if (new URLSearchParams(window.location.search).has("profileUpdate")) {
            bootstrap.Modal.getOrCreateInstance(modal).show();
        }
    });
</script>

<!-- MODAL ĐỔI MẬT KHẨU -->
<div class="modal fade" id="changePassModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-key me-2"></i>Đổi mật khẩu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">

                <!-- HIỂN THỊ THÔNG BÁO THÀNH CÔNG (MÀU XANH) -->
                <% if ("pass_success".equals(request.getParameter("msg"))) { %>
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> Đổi mật khẩu thành công!
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <% } %>

                <!-- Form đổi mật khẩu -->
                <form action="${pageContext.request.contextPath}/change-password" method="POST">

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu cũ <span class="text-danger">*</span></label>
                        <!-- Báo đỏ nếu sai mật khẩu cũ -->
                        <input type="password" class="form-control ${param.error == 'wrong_old_pass' ? 'is-invalid' : ''}" name="oldPass" required>
                        <div class="invalid-feedback">
                            Mật khẩu cũ không chính xác. Vui lòng nhập lại!
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu mới <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" name="newPass" required>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="button" class="btn btn-light border me-2" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-dark fw-bold">Xác nhận đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Script tự động bật lại Modal khi có thông báo thành công hoặc lỗi -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('error') === 'wrong_old_pass' || urlParams.get('msg') === 'pass_success') {
            var myModal = new bootstrap.Modal(document.getElementById('changePassModal'));
            myModal.show();
        }
    });
</script>
